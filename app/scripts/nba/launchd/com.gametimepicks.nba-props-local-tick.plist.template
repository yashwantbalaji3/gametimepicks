<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- NBA prop prices, one local tick every 15 minutes (receipt ODDS_AUTHORIZATION_NBA_PROPS_PRIVATE_2026-11-11).
     TEMPLATE: replace __NPX__, __NODE_BIN__, __REPO__, __HOME__ before installing (see README.md beside this file). The API key is read
     from the founder's existing dotenv file (ODDS_API_KEY line only, mode 600), never from this file. launchd runs node,
     which can read ~/Downloads under TCC (bash cannot); npx tsx runs it, so the .ts imports work on any Node. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.gametimepicks.nba-props-local-tick</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NPX__</string>
    <string>--yes</string>
    <string>tsx</string>
    <string>__REPO__/app/scripts/nba/run-nba-props-local-tick.mjs</string>
    <string>--repo</string><string>__REPO__</string>
    <string>--private</string><string>__HOME__/gtp-private</string>
    <string>--key-env-file</string><string>__HOME__/Downloads/gametimepicks/.env</string>
    <string>--apply</string>
    <string>--commit-ledger</string>
  </array>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><false/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ODDS_API_MIN_CREDITS_REMAINING</key><string>2000</string>
    <key>PATH</key><string>__NODE_BIN__:/usr/bin:/bin</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/gtp-private/odds/nba/props-runner/tick.log</string>
  <key>StandardErrorPath</key><string>__HOME__/gtp-private/odds/nba/props-runner/tick.err</string>
</dict>
</plist>
