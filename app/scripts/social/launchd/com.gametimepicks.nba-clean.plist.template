<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  User LaunchAgent: clean export of founder-approved NBA slate packages (scripts/social/nba-clean-runner.sh). No sudo, no paid
  call, posts nothing. Runs when Command Center rewrites the approvals file (WatchPaths) and every 120 s as a backstop; a pass
  with an unchanged approvals file exits at once. Install with install-nba-clean.sh, which fills the __...__ fields.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__HOME__/gtp-runner/nba-slate/bin/nba-clean-runner.sh</string><string>run</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>GTP_TOOL_COMMIT</key><string>__TOOL_COMMIT__</string>
    <key>GTP_IMPORT_ROOT</key><string>__IMPORT_ROOT__</string>
    <key>GTP_EVIDENCE_ROOT</key><string>__EVIDENCE_ROOT__</string>
  </dict>
  <key>WatchPaths</key>
  <array><string>__IMPORT_ROOT__/approvals/approved-for-clean-export.json</string></array>
  <key>StartInterval</key><integer>120</integer>
  <key>StandardOutPath</key><string>__EVIDENCE_ROOT__/nba-clean/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__EVIDENCE_ROOT__/nba-clean/launchd.err.log</string>
</dict>
</plist>
