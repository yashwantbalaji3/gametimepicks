# Names only. Values are set in the Vercel project / GitHub repository settings at CP-H1 — never committed.

# ── Vercel project "gtp-team" (Production environment only) ──
DATABASE_URL=                 # Neon pooled URL for role gtp_cc_app (printed by deploy/migrate.mjs --roles)
GTP_CC_ORIGIN=https://team.gametimepicks.yashwantbalaji.com
GTP_CC_RP_ID=team.gametimepicks.yashwantbalaji.com
GTP_CC_SETUP_TOKEN_SHA256=    # from deploy/new-setup-token.mjs; delete after the first passkey exists
GH_DISPATCH_TOKEN=            # fine-grained PAT: only repo <owner>/gtp-ops, permission "Actions: read and write", nothing else
GH_OPS_OWNER=yashwantbalaji3
GH_OPS_REPO=gtp-ops
GH_WORKER_WORKFLOW=cc-worker.yml
# Must NOT exist on Vercel: ANTHROPIC_API_KEY, CLAUDE_CODE_OAUTH_TOKEN, OPENAI_API_KEY, XAI_API_KEY (the app refuses to boot).

# ── GitHub repository gtp-ops → Settings → Secrets and variables → Actions ──
CC_WORKER_DATABASE_URL=       # Neon pooled URL for role gtp_cc_worker (printed by deploy/migrate.mjs --roles)
CC_READER_DATABASE_URL=       # Neon pooled URL for role gtp_cc_reader (push job's ledger check)
CLAUDE_CODE_OAUTH_TOKEN=      # from `claude setup-token` on the Mac (subscription; usage credits must stay OFF)

# ── Mac only, one command at a time ──
DATABASE_URL_OWNER=           # Neon owner role, for deploy/migrate.mjs (--roles once)
