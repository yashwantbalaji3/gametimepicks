{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "rm -rf app public && mkdir public && printf 'User-agent: *\\nDisallow: /\\n' > public/robots.txt && cp -R public-snapshot/app app",
  "installCommand": "npm ci --prefix command-center --omit=dev",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "memory": 512,
      "maxDuration": 60,
      "includeFiles": "{command-center/{auth,contracts,hosted,jobs,ledger,lib,orchestrator,providers,publishers,recap,render,roles,engineering,editorial,surfaces/console}/**,app/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/publish",
      "schedule": "*/10 14-23,0-5 * * *"
    }
  ]
}
