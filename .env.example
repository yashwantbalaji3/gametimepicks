# ============================================================================
# GametimePicks — environment variables
# ============================================================================
# Copy this file to .env (do NOT commit .env) and fill in your keys.
# Every key is optional — the app runs on bundled demo data without any of them.
#
# DATA MODES
#   Demo    — both NBA stats and odds come from bundled demo files.
#             No API keys required. Useful for offline development and previews.
#   Live    — both NBA stats and odds come from live providers.
#             Requires ODDS_API_KEY (and nba_api works without a key).
#   Hybrid  — one source is live, the other fell back to demo.
#             Usually means odds came through but NBA.com hiccupped, or vice
#             versa. The data-source badge shows which is which.
# ============================================================================


# ============================================================================
# Provider selection
# ============================================================================
# Which NBA stats provider to use as primary. Options:
#   nba_api       (default — official NBA.com Stats endpoints, no key needed)
#   balldontlie   (requires key + ENABLE_BALLDONTLIE_FALLBACK=true; SCAFFOLD ONLY)
#   espn          (requires ENABLE_ESPN_FALLBACK=true; SCAFFOLD ONLY)
#   sportsdata    (requires key + ENABLE_SPORTSDATA=true; SCAFFOLD ONLY)
#   demo          (always works, no network)
NBA_DATA_PROVIDER=nba_api

# Which odds provider to use as primary. Options:
#   the_odds_api  (default — requires ODDS_API_KEY)
#   opticodds     (requires key + ENABLE_OPTICODDS=true; SCAFFOLD ONLY)
#   sportsdata    (requires key + ENABLE_SPORTSDATA=true; SCAFFOLD ONLY)
#   demo          (always works, no network)
ODDS_PROVIDER=the_odds_api


# ============================================================================
# Data mode hints (override automatic detection)
# ============================================================================
# By default, mode is auto-detected based on which providers succeed.
# These let you force a specific mode for testing or for predictable behavior.
#   demo  = always use the demo provider for this kind of data
#   auto  = auto-detect (default; uses chain order)
NBA_DATA_MODE=demo
ODDS_DATA_MODE=demo


# ============================================================================
# Tier 1 — primary providers
# ============================================================================
# The Odds API — https://the-odds-api.com/
# Free tier: 500 requests/month. ~3 credits per daily NBA prop pull.
ODDS_API_KEY=

# Optional: which sportsbooks to query (comma-separated).
# Examples: draftkings,fanduel,betmgm,caesars
# Leave blank to use the API's default set.
ODDS_BOOKMAKERS=

# Optional: comma-separated list of markets. Default = points/rebounds/assists.
ODDS_MARKETS=player_points,player_rebounds,player_assists


# ============================================================================
# Tier 2/3 — opt-in fallback providers (all SCAFFOLDED, not implemented)
# ============================================================================
# BallDontLie — https://www.balldontlie.io/
ENABLE_BALLDONTLIE_FALLBACK=false
BALLDONTLIE_API_KEY=

# ESPN public API (read-only, schedule + roster fallback only)
ENABLE_ESPN_FALLBACK=false

# OpticOdds — broader sportsbook coverage incl. theScore Bet
ENABLE_OPTICODDS=false
OPTICODDS_API_KEY=

# SportsData.io — commercial NBA stats + (tier-dependent) player props
ENABLE_SPORTSDATA=false
SPORTSDATA_API_KEY=


# ============================================================================
# Behavior
# ============================================================================
# Timezone for date math (default = ET, NBA-standard)
TIMEZONE=America/New_York

# Pipeline output directory (default: ../app/public/data when run from pipeline/)
GTP_DATA_OUT=../app/public/data
