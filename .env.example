# ============================================================================
# GametimePicks — environment variables
# ============================================================================
# Copy this file to .env (do NOT commit .env) and fill in your keys.
# Every key here is OPTIONAL — the app builds and runs on bundled demo data
# without any of them.
#
# Phase 7B-2 is FREE-ONLY. No paid services required, ever.
# Paid keys listed below are commented out and remain deferred indefinitely.
# ============================================================================


# ---------------------------------------------------------------------------
# Data source providers (free)
# ---------------------------------------------------------------------------
# nba_api wraps NBA.com's official public Stats endpoints — no key, no cost.
# It powers schedule, game logs, rosters, and box scores when reachable.
NBA_DATA_PROVIDER=nba_api

# The Odds API provides player props on a 500-credit-per-month free tier.
# Phase 7B-2 wires this in. Once you set ODDS_API_KEY below the pipeline
# will fetch real player props. See docs/odds_api_setup.md.
ODDS_PROVIDER=the_odds_api

# News/injury source. "manual" = read pipeline/manual_overrides/news_signals.json
# Only manual is supported in Phase 7B-1.
NEWS_PROVIDER=manual
INJURY_PROVIDER=manual


# ---------------------------------------------------------------------------
# Data mode hints — force a kind of data to use a specific source
# ---------------------------------------------------------------------------
# "auto"   = use the configured provider chain (recommended)
# "demo"   = always use bundled sample data (useful for offline development)
# "manual" = (news/injury only) read manual overrides JSON
NBA_DATA_MODE=auto
ODDS_DATA_MODE=auto
NEWS_DATA_MODE=manual
INJURY_DATA_MODE=manual


# ---------------------------------------------------------------------------
# API keys (all optional)
# ---------------------------------------------------------------------------
# The Odds API — Phase 7B-2 uses this for player-prop odds. Free tier
# is 500 credits/month at https://the-odds-api.com/. Leave empty to
# render the "Props unavailable — odds provider not configured" state.
# Walkthrough: docs/odds_api_setup.md
ODDS_API_KEY=


# ---------------------------------------------------------------------------
# Slate window
# ---------------------------------------------------------------------------
# How many days of slate to generate, starting today.
# 4 = today + tomorrow + day 2 + day 3.
SLATE_DAYS=4


# ---------------------------------------------------------------------------
# Behavior
# ---------------------------------------------------------------------------
TIMEZONE=America/New_York

# Override pipeline output directory (default: app/public/data)
GTP_DATA_OUT=


# ---------------------------------------------------------------------------
# DEFERRED — paid providers (Phase 7C+, NOT used in Phase 7B-1)
# ---------------------------------------------------------------------------
# These are listed for documentation only. Phase 7B-1 does not call any of
# them. Do not enable until you've evaluated whether the paid value is worth
# the cost for your use case.
#
# BallDontLie GOAT tier ($39.99/mo) — schedule, stats, props, injuries.
# Considered as Phase 7C upgrade option. See docs/roadmap.md.
# BALLDONTLIE_API_KEY=
# ENABLE_BALLDONTLIE_FALLBACK=false
#
# SportsData.io — commercial, sales-quoted (~$250+/mo). Avoid for portfolio.
# SPORTSDATA_API_KEY=
# ENABLE_SPORTSDATA=false
#
# OpticOdds — enterprise pricing. Avoid for portfolio.
# OPTICODDS_API_KEY=
# ENABLE_OPTICODDS=false
#
# X (Twitter) API — pay-per-use ~$0.005/read or $200/mo Basic.
# Manual overrides workflow is the right answer until model is validated.
# X_API_KEY=
# X_API_SECRET=
# X_BEARER_TOKEN=
# ENABLE_X_SIGNALS=false


# ---------------------------------------------------------------------------
# The Odds API tuning (only relevant once ODDS_API_KEY is set)
# ---------------------------------------------------------------------------
# Phase 7B-2 wires The Odds API for real player-prop odds. The free tier
# allows 500 credits/month. Each /events/{id}/odds call costs:
#   markets × regions  credits
# So the defaults below cost 3 credits per event × 6 events = 18 credits per
# pipeline run, leaving ~27 runs/month before depletion. Keep
# ODDS_CACHE_TTL_MINUTES high to avoid re-spending credits on the same data.
#
# Walkthrough: docs/odds_api_setup.md

# Comma-separated bookmaker keys. Empty = The Odds API's regional defaults
# (which can return MANY books and inflate response size). Recommended: keep
# this narrow to 2 books for a free-tier-friendly project.
# Examples: draftkings,fanduel,betmgm,caesars,espnbet
ODDS_BOOKMAKERS=draftkings,fanduel

# Comma-separated markets. Default = points/rebounds/assists. Each added
# market multiplies your per-event credit cost.
# Other markets that may be available: player_threes, player_steals,
# player_blocks, player_turnovers, player_points_rebounds_assists
ODDS_MARKETS=player_points,player_rebounds,player_assists

# Bookmaker regions. "us" only is the standard for NBA props. Adding "us2"
# or "uk" multiplies your credit cost without adding much for NBA.
ODDS_REGIONS=us

# How many events to fetch per pipeline run. The events list endpoint is
# free, but each per-event /odds call costs (markets × regions). Cap this
# to keep your free tier usage predictable. The pipeline matches your
# slate's games to the API's events first, so this only kicks in when you
# have more matched games than the cap.
ODDS_MAX_EVENTS_PER_RUN=6

# How long to cache The Odds API responses, in minutes. Higher = fewer
# credits burned, but staler odds. 60 (one hour) is a good starting point;
# bump to 120+ if you're running the pipeline multiple times an hour during
# development.
ODDS_CACHE_TTL_MINUTES=60

# ----------------------------------------------------------------------------
# Phase 7B-3 — dry-run mode for safe key activation testing
# ----------------------------------------------------------------------------
# When ODDS_DRY_RUN=true:
#   - The pipeline still calls /events for the slate (FREE — costs 0 credits)
#     so you can see how many games The Odds API has for the date and
#     whether your key works.
#   - It SKIPS /events/{id}/odds calls (which would cost markets × regions
#     credits each).
#   - oddsProviderStatus is set to "dry_run".
#   - The board renders the schedule with a "Dry-run mode — odds fetches
#     skipped to preserve credits" banner instead of real prop cards.
#
# Use this for the first run after adding ODDS_API_KEY. Once you're happy
# with the wiring, set this to false (or remove the line) for a real run.
ODDS_DRY_RUN=false
