# ============================================================================
# GametimePicks — environment variables
# ============================================================================
# Copy this file to .env (do NOT commit .env) and fill in your keys.
# Every key here is OPTIONAL — the app builds and runs on bundled demo data
# without any of them.
#
# Phase 7B-1 is FREE-ONLY. No paid services required, ever.
# Paid keys listed below are commented out and deferred to future phases.
# ============================================================================


# ---------------------------------------------------------------------------
# Data source providers (free)
# ---------------------------------------------------------------------------
# nba_api wraps NBA.com's official public Stats endpoints — no key, no cost.
# It powers schedule, game logs, rosters, and box scores when reachable.
NBA_DATA_PROVIDER=nba_api

# The Odds API provides player props on a 500-credit-per-month free tier.
# Phase 7B-1 does NOT yet integrate this. Phase 7B-2 will, once you grab
# a free key from https://the-odds-api.com/
ODDS_PROVIDER=the_odds_api

# News/injury source. "manual" = read pipeline/manual_overrides/news_signals.json
# Only manual is supported in Phase 7B-1.
NEWS_PROVIDER=manual
INJURY_PROVIDER=manual


# ---------------------------------------------------------------------------
# Data mode hints — force a kind of data to use a specific source
# ---------------------------------------------------------------------------
# "auto"   = use the configured provider chain (recommended)
# "demo"   = always use bundled sample data (useful for offline development)
# "manual" = (news/injury only) read manual overrides JSON
NBA_DATA_MODE=auto
ODDS_DATA_MODE=auto
NEWS_DATA_MODE=manual
INJURY_DATA_MODE=manual


# ---------------------------------------------------------------------------
# API keys (all optional)
# ---------------------------------------------------------------------------
# The Odds API — Phase 7B-2 will use this. Free tier 500 req/mo at
# https://the-odds-api.com/. Leave empty until you have one.
ODDS_API_KEY=


# ---------------------------------------------------------------------------
# Slate window
# ---------------------------------------------------------------------------
# How many days of slate to generate, starting today.
# 4 = today + tomorrow + day 2 + day 3.
SLATE_DAYS=4


# ---------------------------------------------------------------------------
# Behavior
# ---------------------------------------------------------------------------
TIMEZONE=America/New_York

# Override pipeline output directory (default: app/public/data)
GTP_DATA_OUT=


# ---------------------------------------------------------------------------
# DEFERRED — paid providers (Phase 7C+, NOT used in Phase 7B-1)
# ---------------------------------------------------------------------------
# These are listed for documentation only. Phase 7B-1 does not call any of
# them. Do not enable until you've evaluated whether the paid value is worth
# the cost for your use case.
#
# BallDontLie GOAT tier ($39.99/mo) — schedule, stats, props, injuries.
# Considered as Phase 7C upgrade option. See docs/roadmap.md.
# BALLDONTLIE_API_KEY=
# ENABLE_BALLDONTLIE_FALLBACK=false
#
# SportsData.io — commercial, sales-quoted (~$250+/mo). Avoid for portfolio.
# SPORTSDATA_API_KEY=
# ENABLE_SPORTSDATA=false
#
# OpticOdds — enterprise pricing. Avoid for portfolio.
# OPTICODDS_API_KEY=
# ENABLE_OPTICODDS=false
#
# X (Twitter) API — pay-per-use ~$0.005/read or $200/mo Basic.
# Manual overrides workflow is the right answer until model is validated.
# X_API_KEY=
# X_API_SECRET=
# X_BEARER_TOKEN=
# ENABLE_X_SIGNALS=false


# ---------------------------------------------------------------------------
# The Odds API tuning (only relevant once ODDS_API_KEY is set in Phase 7B-2)
# ---------------------------------------------------------------------------
# Comma-separated bookmaker keys. Leave blank for The Odds API's defaults.
# Examples: draftkings,fanduel,betmgm,caesars
ODDS_BOOKMAKERS=

# Comma-separated markets. Default = points/rebounds/assists.
ODDS_MARKETS=player_points,player_rebounds,player_assists
