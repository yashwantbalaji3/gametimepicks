# ============================================================================
# GametimePicks .gitignore
# ============================================================================

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.python-version
.venv/
venv/
env/

# ---- Node / Next.js ---------------------------------------------------------
app/node_modules/
app/.next/
app/out/
app/.turbo/
app/.swc/
app/next-env.d.ts
app/coverage/

# Lockfiles other than package-lock.json (we commit npm by default)
app/yarn.lock
app/pnpm-lock.yaml
app/bun.lockb

# ---- Environment ------------------------------------------------------------
# Never commit secrets. .env.example IS committed.
.env
.env.local
.env.*.local
!.env.example
*.pem

# ---- Pipeline runtime artifacts --------------------------------------------
# The cache directory holds raw API responses; never commit.
pipeline/cache/*
!pipeline/cache/.gitkeep
# Raw StatsAPI gamelog fetch caches — regenerable, never commit.
data/internal/mlb/reference/pitcher-gamelog-cache.json
data/internal/mlb/reference/pitcher-gamelog-full-cache.json

# Optional intermediate data dirs (used if you save raw CSVs locally)
pipeline/data/raw/*
pipeline/data/processed/*
!pipeline/data/raw/.gitkeep
!pipeline/data/processed/.gitkeep

# Demo data IS committed — it's the offline fallback the app needs to render.
!pipeline/demo_data/*.json

# ---- IDE / OS ---------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Logs / temp ------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
tmp/

# ---- Build artifacts that shouldn't escape ---------------------------------
*.tsbuildinfo
*.zip
!visuals/*.png
!visuals/*.jpg
# Pregame market archive: large point-in-time Odds-API payloads persist via workflow ARTIFACTS, not git.
# Keep only manifest.json in-repo (small, durable provenance + hashes + counts); ignore raw + normalized.
data/internal/mlb/pregame-archive/market-snapshots/**/raw.json
data/internal/mlb/pregame-archive/market-snapshots/**/normalized.json
# SPRINT 039: the GZIPPED normalized payload IS retained — it is the durable research record.
# Measured 46-53x compression (1702KB -> 32KB), ~26 KB/capture x 16/day = ~150 MB/year, so git is
# viable and no object storage is needed. raw.json stays ignored (provider blob); normalized carries
# every research field plus provenance and an integrity hash.
!data/internal/mlb/pregame-archive/market-snapshots/**/normalized.json.gz
# ResearchObservations are a DERIVED materialized view (multi-MB/day), deterministically regenerable from the
# committed settlement-joins (which embed the settled marketRows + noVig probabilities). Persist via workflow
# ARTIFACTS + committed STATUS summaries (research-progress / research-observation-quality / benchmark), not the raw jsonl.
data/internal/mlb/pregame-archive/research-observations/*.jsonl
# Research eligibility QUARANTINE audit — a derived per-date index of rows downgraded by the canonical re-validation
# gate, deterministically regenerable from the committed settlement-joins (which carry the corrected researchEligible
# + eligibilityReason as the durable evidence). Large; persisted via the quarantine script, not committed.
data/internal/mlb/research-quarantine/*.json
# Public-beta social content: derived daily analytics summaries, deterministically regenerable from the
# committed game-simulations board via build-mlb-social-content.mjs. INTERNAL (public:false, notBettingAdvice)
# — the SCRIPT is the deliverable; the dated JSON output is regenerated, not versioned (avoids daily churn).
data/internal/mlb/social/*.json

# Build marker (scripts/build-info.mjs --emit) — regenerated every build, never committed.
app/.build-info.json
.tmp/

# Raw provider response bodies are never committed — this repository is PUBLIC and the payloads are a
# licensed provider's. The api-football player backfill that wrote here was retired on 2026-08-21
# (superseded by the free, unmetered ESPN capture), but the rule stays: any future raw capture lands
# here and stays out of git. Only our own derived extractions are tracked.
data/internal/research/epl/players/raw/
