+  /* FIXTURE: a weekend morning before the NBA lane publishes (2026-10-25: Ligue 1 cards recorded 04:42Z, NBA lane 14:33Z). */
+  const soccerOnly = levelASuggestions({ selections: [sel("ligue-1", 0.62), sel("ligue-1", 0.6), sel("ligue-1", 0.52), sel("ligue-1", 0.46)], now: NOW, productDay: DAY });
