+/**
+ * The slots the mixed switch fills. A mixed card takes its slot; a slot the mixed rule leaves EMPTY (fewer than two sports
+ * with a published probability, e.g. a soccer morning before the NBA lane publishes, or no mixed combination in that band)
+ * keeps the cross-sport card the switch-OFF model shows there, under its own policy. So switching mixed ON never removes a
+ * card readers would otherwise see; it only adds or replaces. Pure.
+ */
+export function mixedSlots(mixed, answer) {
+  const keep = (m, a) => (m.card || !a?.card ? m : a);
+  return {
+    parlayLab: mixed.parlayLab.map((t) => keep(t, answer.parlayLab.find((a) => a.tier === t.tier))),
+    bankBuilder: keep(mixed.bankBuilder, answer.bankBuilder),
+    moonshot: keep(mixed.moonshot, answer.moonshot),
+  };
+}
