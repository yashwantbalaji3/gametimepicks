+test("ON NEVER REMOVES A CARD: a slot the mixed rule leaves empty keeps the switch-OFF cross-sport card (one-sport morning)", () => {
+  /* FIXTURE: a weekend morning before the NBA lane publishes (2026-10-25: Ligue 1 cards recorded 04:42Z, NBA lane 14:33Z). */
+  const soccerOnly = levelASuggestions({ selections: [sel("ligue-1", 0.62), sel("ligue-1", 0.6), sel("ligue-1", 0.52), sel("ligue-1", 0.46)], now: NOW, productDay: DAY });
+  const m = levelAMixed({ crossSportLegs: soccerOnly.legs, nbaLegs: [], disclosure: null, enabled: true });
+  assert.ok([...m.parlayLab, m.bankBuilder, m.moonshot].every((s) => s.card === null), "one sport: the mixed rule alone shows nothing");
+  assert.match(m.bankBuilder.reason, /today only Ligue 1 has a leg/);
+  assert.match(levelAMixed({ crossSportLegs: [], nbaLegs: [], enabled: true }).bankBuilder.reason, /today no sport has a leg/, "reads as a sentence with no legs at all");
+  const slots = mixedSlots(m, soccerOnly);
+  const shownOff = [...soccerOnly.parlayLab, soccerOnly.bankBuilder, soccerOnly.moonshot].filter((s) => s.card).length;
+  assert.ok(shownOff >= 3, "the fixture must give the OFF model cards, or this test is vacuous");
+  assert.deepEqual(slots.parlayLab.map((t) => t.card?.policy ?? null), soccerOnly.parlayLab.map((t) => t.card?.policy ?? null));
+  assert.equal(slots.bankBuilder, soccerOnly.bankBuilder);
+  assert.equal(slots.moonshot, soccerOnly.moonshot);
+  /* And a filled mixed slot still wins its slot. */
+  const both = levelAMixed({ crossSportLegs: crossSport(), nbaLegs: NBA_LEGS, disclosure: DISCLOSURE, enabled: true });
+  const s2 = mixedSlots(both, levelASuggestions({ selections: [sel("mlb", 0.62), sel("epl", 0.55)], now: NOW, productDay: DAY }));
+  for (const [i, t] of both.parlayLab.entries()) if (t.card) assert.equal(s2.parlayLab[i], t);
+});
